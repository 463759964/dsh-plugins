{
  "name": "dsh-workbuddy-bridge",
  "version": "1.0.0",
  "description": "把本机 WorkBuddy 账号里的模型接进 DeepSeek Harness：进程内起一个只监听 127.0.0.1 的 OpenAI 兼容端点，令牌从本地登录态取，用完即弃。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "workbuddy",
    "bridge",
    "openai-compatible"
  ],
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./serve": {
      "default": "./lib/serve.mjs"
    },
    "./upstream": {
      "default": "./lib/upstream.mjs"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "files": [
    "lib",
    "tools",
    "client.js",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "install.mjs",
    "uninstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install-plugin": "node install.mjs",
    "uninstall-plugin": "node uninstall.mjs",
    "doctor": "node tools/doctor.mjs",
    "serve": "node lib/serve.mjs",
    "models": "node tools/list-models.mjs",
    "credits": "node tools/credits.mjs",
    "test": "node tools/test-usage.mjs && node tools/test-junction-safety.mjs"
  }
}
